    // changed from humanresources to worker in order to try from scratch
    agent worker:worker.asl {
        ag-class:   vesna.VesnaAgent
        temper:     temper( focused(0.5)[mood] )
        address:    localhost
        port:       9081
        strategy:   most_similar
        goals:      start
        beliefs:    my_desk( junior_10_desk )
    }

    agent client1:client.asl {
        ag-class:   vesna.VesnaAgent
        temper:     temper( curiosity(0.6), social(0.4), understanding(0.5)[mood], patience(0.8)[mood] )
        address:    localhost
        port:       9082
        strategy:   most_similar
        goals:      start
        // beliefs:    my_name( Me )
    }

}
