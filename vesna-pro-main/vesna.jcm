mas vesna {

    // agent alice:alice.asl {
    //    ag-class:   vesna.VesnaAgent
    //    temper:     temper( prop1(0.2), prop2(0.3), prop3(-0.5)[mood], prop4(0.3)[mood] )
    //    address:    localhost
    //    port:       9080
    //    strategy:   most_similar
    //    goals:      start
    //}

    agent humanresources:humanresources.asl {
        ag-class:   vesna.VesnaAgent
        temper:     temper( hardworking(0.5), social(0.3), focus(0.7)[mood], availability(0.9)[mood] )
        address:    localhost
        port:       9081
        strategy:   most_similar
        goals:      start
    }

    agent client1:client.asl {
        ag-class:   vesna.VesnaAgent
        temper:     temper( curiosity(0.6), social(0.4), understanding(0.5)[mood], patience(0.8)[mood] )
        address:    localhost
        port:       9082
        strategy:   most_similar
        goals:      start
    }

    workspace wp {
        artifact coffee_machine: vesna.playgrounds.office.CoffeeMachine("common", 1)
        artifact cup1: vesna.playgrounds.office.Cup("common")
        artifact cup2: vesna.playgrounds.office.Cup("common")
        artifact cup3: vesna.playgrounds.office.Cup("common")
        artifact white_pages: kqml_s.WhitePages
    }

}
