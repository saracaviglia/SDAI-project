mas vesna {

    agent worker:worker.asl {
        ag-class:   vesna.VesnaAgent
        temper:     temper( focused(0.5)[mood] )
        address:    localhost
        port:       9081
        strategy:   most_similar
        goals:      start
        beliefs:    my_desk( junior_10_desk )
    }

    agent client1:client.asl {
        ag-class:   vesna.VesnaAgent
        temper:     temper( curiosity(0.6), social(0.4), understanding(0.5)[mood], patience(0.8)[mood] )
        address:    localhost
        port:       9082
        strategy:   most_similar
        goals:      start
    }

    agent client2:client.asl {
        ag-class:   vesna.VesnaAgent
        temper:     temper( curiosity(0.6), social(0.4), understanding(0.5)[mood], patience(0.8)[mood] )
        address:    localhost
        port:       9083
        strategy:   most_similar
        goals:      start
    }

    agent humanresources:humanresources.asl {
        ag-class:   vesna.VesnaAgent
        temper:     temper( focused(0.5)[mood] )
        address:    localhost
        port:       9084
        strategy:   most_similar
        goals:      start
    }

    agent director:director.asl {
        ag-class:   vesna.VesnaAgent
        temper:     temper( focused(0.5)[mood] )
        address:    localhost
        port:       9085
        strategy:   most_similar
        goals:      start
    }

}
